{
  "name": "superagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=24.4.0 <25"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tests/types/tsconfig.json && tsc -p tests/types-node/tsconfig.json",
    "test": "node --test tests/contract/*.test.mjs tests/tooling/*.test.mjs tests/integration/*.test.mjs tests/fault-injection/*.test.mjs",
    "test:reference": "uv run --no-project --with-requirements requirements-contracts.txt python -X utf8 scripts/validate-reference.py",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:freeze": "node scripts/check-contract-freeze.mjs",
    "check": "pnpm check:boundaries && pnpm check:freeze && pnpm build && pnpm typecheck && pnpm test && pnpm test:reference",
    "demo:m1": "node scripts/m1-demo.mjs",
    "worker:m1": "node scripts/m1-worker.mjs",
    "source:m4": "node scripts/m4-source.mjs",
    "demo:m3": "node scripts/m3-demo.mjs",
    "worker:m3": "node scripts/m3-worker.mjs",
    "qq:source": "node scripts/qq-source.mjs",
    "qq:menu": "node scripts/qq-menu.mjs",
    "bench:qq-live": "node scripts/benchmark-qq-live.mjs",
    "qq:probe": "node scripts/qq-probe.mjs",
    "qq:send-test": "node scripts/qq-send-test.mjs",
    "test:m6": "pnpm build && node --test tests/fault-injection/*.test.mjs tests/integration/qq-gateway.test.mjs tests/integration/qq-source.test.mjs tests/integration/qq-delivery.test.mjs tests/integration/qq-card-retirement.test.mjs tests/integration/m3-recovery.test.mjs tests/integration/crash-bulk.test.mjs tests/integration/m5-actions.test.mjs",
    "demo:m5": "node scripts/m5-demo.mjs",
    "start:m5": "node scripts/m5-run.mjs",
    "m5:key": "node scripts/m5-access.mjs",
    "preview:qq": "node scripts/qq-template-preview.mjs",
    "start": "node scripts/superagent.mjs"
  },
  "devDependencies": {
    "@superagent/agent-core": "workspace:*",
    "@superagent/agent-workers": "workspace:*",
    "@superagent/connector-discord": "workspace:*",
    "@superagent/connector-steam-discussions": "workspace:*",
    "@superagent/connector-steam-reviews": "workspace:*",
    "@superagent/contract-validation": "workspace:*",
    "@superagent/contracts": "workspace:*",
    "@superagent/control-plane": "workspace:*",
    "@superagent/domain": "workspace:*",
    "@superagent/feedback-buffer": "workspace:*",
    "@superagent/ingress": "workspace:*",
    "@superagent/issue-tracker": "workspace:*",
    "@superagent/job-queue": "workspace:*",
    "@superagent/llm": "workspace:*",
    "@superagent/memory": "workspace:*",
    "@superagent/persistence": "workspace:*",
    "@superagent/plugin-host": "workspace:*",
    "@superagent/plugin-sdk": "workspace:*",
    "@superagent/qq-official": "workspace:*",
    "@superagent/reporting": "workspace:*",
    "@superagent/web-console": "workspace:*",
    "@types/node": "24.0.15",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commonmark": "0.31.2",
    "linkedom": "0.18.15",
    "typescript": "5.9.3"
  }
}
