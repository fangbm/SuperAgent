{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superagent.local/schemas/feedback-batch-v1.schema.json",
  "title": "FeedbackBatchV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batchId",
    "projectId",
    "sourceId",
    "segmentIds",
    "candidateEventIds",
    "contextEventIds",
    "policyVersion",
    "revision",
    "reason",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "batchId": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "segmentIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "candidateEventIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Host-generated InternalEventId strings; never CloudEvents id (source-local)"
    },
    "contextEventIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Host-generated InternalEventId strings; never CloudEvents id (source-local)"
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "reason": {
      "enum": [
        "quiet_timeout",
        "max_wait",
        "size_limit",
        "urgent",
        "replay"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
