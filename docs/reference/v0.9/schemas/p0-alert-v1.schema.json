{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superagent.local/schemas/p0-alert-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "alertId",
    "incidentId",
    "issueId",
    "projectId",
    "severity",
    "alertGeneration",
    "title",
    "summary",
    "evidence",
    "detectedAt",
    "policyVersion",
    "deliveryRequested"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "alertId": {
      "type": "string",
      "minLength": 1
    },
    "incidentId": {
      "type": "string",
      "minLength": 1
    },
    "issueId": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "const": "P0"
    },
    "alertGeneration": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "eventId"
        ],
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1
          },
          "feedbackId": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          }
        }
      }
    },
    "detectedAt": {
      "type": "string",
      "format": "date-time"
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1
    },
    "deliveryRequested": {
      "type": "boolean"
    }
  }
}
