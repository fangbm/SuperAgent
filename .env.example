# Read by your shell/process launcher; the application does not load .env files.
SA_LLM_BASE_URL=https://api.deepseek.com
SA_LLM_MODEL=deepseek-flash
SA_LLM_API_KEY=
# Optional semantic retrieval; separate credentials, no automatic key forwarding.
SA_EMBED_BASE_URL=
SA_EMBED_MODEL=
SA_EMBED_API_KEY=
# Optional GitHub. worker:m3 also needs --project and explicit --github-write.
SA_GITHUB_REPOSITORY=owner/private-feedback
SA_GITHUB_TOKEN=
# QQ Official plugins: independent Source and developer-only C2C Delivery.
SA_QQ_APP_ID=
SA_QQ_APP_SECRET=
# Raw group/channel/C2C scope ID stays in trusted plugin configuration.
SA_QQ_SCOPE_ID=
# At least 32 random bytes. Keep stable for a source's pseudonym identities.
SA_QQ_PSEUDONYM_KEY=
SA_QQ_DEVELOPER_OPENID=
# M5 local console. Windows can generate DPAPI-protected keys instead.
SA_WEB_ACCESS_KEY=
SA_WEB_READER_KEY=
SA_CURSOR_SIGNING_KEY=
