# Read by your shell/process launcher; the application does not load .env files.
SA_LLM_BASE_URL=https://api.deepseek.com
SA_LLM_MODEL=deepseek-flash
SA_LLM_API_KEY=
# Optional semantic retrieval; separate credentials, no automatic key forwarding.
SA_EMBED_BASE_URL=
SA_EMBED_MODEL=
SA_EMBED_API_KEY=
# Optional GitHub. worker:m3 also needs --project and explicit --github-write.
SA_GITHUB_REPOSITORY=owner/private-feedback
SA_GITHUB_TOKEN=
