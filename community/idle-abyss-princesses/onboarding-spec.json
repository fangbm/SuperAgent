  "guildTag": {
    "type": "native_discord_server_tag_additional_perk",
    "candidate": "ABYS",
    "separateFrom": "member roles and forum tags",
    "activation": "Current Discord Help Center says Server Tags require three available Server Boosts as an additional perk, independent of server boost level. This proposal does not check availability, unlock, claim, purchase, or activate the perk. Keep ABYS as a candidate only; it may require paid boosts if none are already available.",
    "label": "Discord calls this a Server Tag; distinguish it from member roles, forum tags, and the separate Discord Guilds product."
  },
